{
  "name": "p2p-portal",
  "version": "0.1.0",
  "private": true,
  "description": "P2P Finance Portal — Next.js di Vercel, Google Sheets/Drive, Upstash Redis. Trial = DATA DUMMY saja.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm run test",
    "gen-golden": "node scripts/gen-golden.mjs",
    "anonymize": "tsx scripts/anonymize-dummy.ts",
    "check-headers": "tsx scripts/check-headers.ts",
    "seed": "tsx scripts/seed-dummy.ts",
    "m1-integration": "tsx scripts/m1-integration.ts",
    "m4b-integration": "tsx --env-file=.env.local scripts/m4b-integration.ts",
    "issue-setpass": "tsx --env-file=.env.local scripts/issue-setpass.ts",
    "wa-webhook-test": "tsx --env-file=.env.local scripts/wa-webhook-test.ts",
    "load-test": "tsx scripts/load-test.ts"
  },
  "dependencies": {
    "@upstash/redis": "^1.39.0",
    "google-auth-library": "^10.0.0",
    "next": "^16.4.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^5.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^2.1.0"
  }
